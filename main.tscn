[sub_resource type="Shader" id="Shader_procedural_nebula"]
code = "shader_type canvas_item;

uniform float primary_intensity : hint_range(0.0, 0.25) = 0.14;
uniform float secondary_intensity : hint_range(0.0, 0.15) = 0.075;
uniform float primary_drift_seconds : hint_range(40.0, 70.0) = 56.0;
uniform float secondary_drift_seconds : hint_range(40.0, 80.0) = 68.0;
uniform float ambience_intensity : hint_range(0.0, 0.03) = 0.012;
uniform vec3 deep_navy = vec3(0.015, 0.045, 0.10);
uniform vec3 muted_cyan = vec3(0.055, 0.22, 0.28);
uniform vec3 muted_indigo = vec3(0.12, 0.065, 0.23);

float hash21(vec2 point) {
	point = fract(point * vec2(123.34, 456.21));
	point += dot(point, point + 45.32);
	return fract(point.x * point.y);
}

float value_noise(vec2 point) {
	vec2 cell = floor(point);
	vec2 local = fract(point);
	local = local * local * (3.0 - 2.0 * local);
	float a = hash21(cell);
	float b = hash21(cell + vec2(1.0, 0.0));
	float c = hash21(cell + vec2(0.0, 1.0));
	float d = hash21(cell + vec2(1.0, 1.0));
	return mix(mix(a, b, local.x), mix(c, d, local.x), local.y);
}

float fbm(vec2 point) {
	float sum = 0.0;
	float weight = 0.55;
	for (int octave = 0; octave < 3; octave++) {
		sum += value_noise(point) * weight;
		point = point * 2.03 + vec2(13.7, 9.2);
		weight *= 0.48;
	}
	return sum;
}

void fragment() {
	vec2 aspect_uv = vec2(UV.x * 1.78, UV.y);

	float primary_time = TIME / max(primary_drift_seconds, 1.0);
	vec2 primary_uv = aspect_uv + vec2(primary_time * 0.72, primary_time * 0.22);
	float primary_warp = fbm(primary_uv * 1.55 + vec2(2.4, 5.7));
	float primary_detail = fbm(primary_uv * 3.15 + vec2(8.1, 1.3));
	float diagonal_center = 0.52 + (UV.x - 0.5) * 0.24 + (primary_warp - 0.5) * 0.30;
	float band_distance = abs(UV.y - diagonal_center);
	float primary_band = 1.0 - smoothstep(0.10, 0.34, band_distance);
	primary_band *= smoothstep(0.34, 0.72, primary_warp * 0.62 + primary_detail * 0.38);

	float secondary_time = TIME / max(secondary_drift_seconds, 1.0);
	vec2 secondary_center = vec2(
		1.22 + sin(secondary_time * 6.28318) * 0.18,
		0.68 + cos(secondary_time * 6.28318) * 0.12
	);
	vec2 secondary_delta = aspect_uv - secondary_center;
	secondary_delta.x *= 0.72;
	float secondary_warp = fbm(aspect_uv * 2.35 - vec2(secondary_time * 0.48, secondary_time * 0.20) + vec2(11.2, 3.6));
	float secondary_blob = 1.0 - smoothstep(0.16, 0.48, length(secondary_delta) + (secondary_warp - 0.5) * 0.18);
	secondary_blob *= smoothstep(0.30, 0.66, secondary_warp);

	float ambience_wave = 0.5 + 0.5 * sin(TIME * 6.28318 / 20.0);
	float ambience_alpha = ambience_intensity * mix(0.35, 1.0, ambience_wave);
	float primary_alpha = primary_band * primary_intensity;
	float secondary_alpha = secondary_blob * secondary_intensity;
	float total_alpha = clamp(primary_alpha + secondary_alpha + ambience_alpha, 0.0, 0.18);
	vec3 combined_color = deep_navy;
	combined_color = mix(combined_color, muted_cyan, primary_alpha / max(total_alpha, 0.0001));
	combined_color = mix(combined_color, muted_indigo, secondary_alpha / max(total_alpha, 0.0001));
	combined_color = mix(combined_color, vec3(0.07, 0.11, 0.18), ambience_alpha / max(total_alpha, 0.0001));
	COLOR = vec4(combined_color, total_alpha);
}"

