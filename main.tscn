[sub_resource type="Shader" id="Shader_paddle_energy_flow"]
code = "shader_type canvas_item;

void fragment() {
	vec2 uv = UV;
	uv.x += sin(UV.y * 18.0 + TIME * 1.15) * 0.0035;
	uv.y += sin(UV.x * 22.0 - TIME * 0.95) * 0.004;
	vec4 energy = texture(TEXTURE, uv);
	float flow = 0.92 + 0.14 * sin(UV.x * 24.0 - TIME * 1.4);
	COLOR = energy * COLOR * vec4(vec3(flow), 1.0);
}"

