[sub_resource type="Shader" id="Shader_edge_vignette"]
code = "shader_type canvas_item;

uniform vec4 glow_color : source_color = vec4(0.0, 0.9, 1.0, 1.0);
uniform float glow_strength : hint_range(0.0, 1.0) = 0.0;
uniform float glow_width : hint_range(1.0, 150.0) = 60.0;

void fragment() {
	float left_glow = 1.0 - smoothstep(0.0, glow_width, UV.x / SCREEN_PIXEL_SIZE.x);
	float right_glow = 1.0 - smoothstep(0.0, glow_width, (1.0 - UV.x) / SCREEN_PIXEL_SIZE.x);
	float top_glow = 1.0 - smoothstep(0.0, glow_width, UV.y / SCREEN_PIXEL_SIZE.y);
	float bottom_glow = 1.0 - smoothstep(0.0, glow_width, (1.0 - UV.y) / SCREEN_PIXEL_SIZE.y);

	float horizontal_glow = max(left_glow, right_glow);
	float vertical_glow = max(top_glow, bottom_glow);
	float soft_union = 1.0 - (1.0 - horizontal_glow) * (1.0 - vertical_glow);
	soft_union = pow(soft_union, 1.35);

	COLOR = vec4(glow_color.rgb, soft_union * glow_strength);
}"

